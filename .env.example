# Copie para .env apenas se ainda não existir. Nunca envie .env ao Git ou ao chat.
NODE_ENV=development
PORT=4000

# Banco de desenvolvimento. Use senha forte e mantenha a mesma no compose local.
DATABASE_URL=postgresql://petcore:COLOQUE_UMA_SENHA_FORTE@localhost:5432/petcore
POSTGRES_LOCAL_PASSWORD=COLOQUE_A_MESMA_SENHA_DO_DATABASE_URL
DATABASE_SSL=false
# Em nuvem use TLS com verificação de certificado e o banco correto do ambiente.
# Migrations/backups preferem a conexão direta ao MESMO banco; vazio usa DATABASE_URL.
DATABASE_DIRECT_URL=

# Gere um segredo aleatório de pelo menos 40 caracteres; não reutilize um exemplo.
SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
# Produção exige APP_ORIGIN explícita em HTTPS, sem caminho/credenciais/curinga.
# Para celular na mesma rede, adicione somente a origem Network real do Vite.
# Múltiplas origens separadas por vírgula; normalmente vazio no Railway.
APP_ALLOWED_ORIGINS=

# Bootstrap só em ambiente autorizado de desenvolvimento. Não rode seed em produção.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_OWNER_PASSWORD=

# Recuperação de senha: desabilitada até configurar e homologar o provedor/remetente.
# Para habilitar: EMAIL_PROVIDER=resend, API key e remetente validado no Resend.
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=

# Lembretes: processo separado; estas credenciais NÃO substituem EMAIL_* acima.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
REMINDER_EMAILS_ENABLED=false
REMINDER_EMAILS_CONFIRM_SEND=NO

# Fotos de pets: bucket S3 compatível privado, com credenciais limitadas.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Backups: outro bucket privado, distinto do bucket de fotos.
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_REGION=auto
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_ACCESS_KEY=
BACKUP_STORAGE_SECRET_KEY=
BACKUP_STORAGE_PREFIX=petcore
# Gere 32 bytes aleatórios em 64 caracteres hexadecimais; guarde cópia protegida.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_ID=primary
# No Windows, configure o caminho completo se os clientes PostgreSQL 18 não estiverem no PATH.
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
# PG_RESTORE_PATH=C:/Program Files/PostgreSQL/18/bin/pg_restore.exe
MAINTENANCE_INTERVAL_SECONDS=60

# Integrações usam SOMENTE banco independente terminado em _test.
TEST_DATABASE_URL=postgresql://petcore:COLOQUE_UMA_SENHA_FORTE@localhost:5432/petcore_test
# Restauração exige banco NOVO/VAZIO, diferente da origem, terminado em _restore_test.
RESTORE_DATABASE_URL=

# Planos/contatos ficam no banco e no painel da plataforma:
# Free por 30 dias, Mensal R$ 35, Anual R$ 350; suporte/privacidade tigertechbr@outlook.com.
# PagBank PF atual usa links externos + conciliação manual: nenhum token é necessário.
# Não adicione tokens de produção só para este fluxo nem libere links sem revisão.
