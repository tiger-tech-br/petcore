# Copie este arquivo para .env. Nunca envie .env ao Git.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://petcore:COLOQUE_UMA_SENHA_FORTE@localhost:5432/petcore
# Em nuvem use SSL gerenciado do provedor (não desative a verificação de certificado).
DATABASE_SSL=false
POSTGRES_LOCAL_PASSWORD=COLOQUE_A_MESMA_SENHA_DO_DATABASE_URL
SESSION_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_COM_64_CARACTERES_OU_MAIS
APP_ORIGIN=http://localhost:5173
# Origens adicionais, separadas por vírgula. Para testar pelo celular na mesma rede,
# informe o endereço Network exibido pelo Vite, por exemplo http://192.168.0.9:5173.
# Use somente endereços explícitos do sistema, sem *; deixe vazio se não precisar.
APP_ALLOWED_ORIGINS=
# Para criar o primeiro administrador: forneça valores PRIVADOS ao comando db:seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_OWNER_PASSWORD=
# Serviço de e-mail (etapa posterior):
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
# Fotos de pets: integração com armazenamento S3 compatível (exige credenciais reais)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Pagamento recorrente: etapa posterior, sempre credenciais sandbox primeiro
PAYMENT_PROVIDER=
PAYMENT_SANDBOX_SECRET=
# Testes de integração: USE UM BANCO INDEPENDENTE terminado em _test
TEST_DATABASE_URL=postgresql://petcore:COLOQUE_UMA_SENHA_FORTE@localhost:5432/petcore_test
