{
  "name": "@petcore/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-strip-types --test tests/scheduling.unit.test.ts tests/originGuard.unit.test.ts tests/petPhoto.unit.test.ts tests/backup.unit.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/saas.integration.test.ts tests/crm.integration.test.ts tests/business.integration.test.ts tests/privacy.integration.test.ts tests/commercial.integration.test.ts tests/uploads.integration.test.ts tests/auth.integration.test.ts tests/reminders.integration.test.ts tests/taxiDog.integration.test.ts",
    "ops:maintenance": "node dist/maintenance.js --once",
    "ops:backup": "node scripts/backup.mjs",
    "ops:restore-check": "node scripts/restore-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "argon2": "^0.44.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "resend": "^6.37.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
